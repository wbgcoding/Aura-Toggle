<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AuraToggle</AssemblyName>
    <RootNamespace>AuraToggle</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>assets\aura.ico</ApplicationIcon>
    <ApplicationManifest>src\app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.2.1</Version>
    <Company>BGCoding</Company>
    <Product>Aura Toggle</Product>
    <AssemblyTitle>Aura Toggle</AssemblyTitle>
    <Description>Switches ASUS Aura mainboard lighting on and off.</Description>
    <Copyright>© 2026 BGCoding</Copyright>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <!-- Without this the executable carries the absolute path it was built from, symbol file
         included, straight into a public download. Mapping the project directory to a relative
         one keeps the symbols usable for reading a stack trace while shipping nothing about the
         machine that produced them. -->
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    <DeterministicSourcePaths Condition="'$(ContinuousIntegrationBuild)' == ''">false</DeterministicSourcePaths>
  </PropertyGroup>

  <ItemGroup>
    <!-- Logical names are set by hand: the default would carry the src folder into them. -->
    <EmbeddedResource Include="src\Strings.resx" LogicalName="AuraToggle.Strings.resources" />
    <EmbeddedResource Include="src\StringsDe.resx" LogicalName="AuraToggle.StringsDe.resources" />
    <EmbeddedResource Include="src\StringsEs.resx" LogicalName="AuraToggle.StringsEs.resources" />
    <EmbeddedResource Include="src\StringsPtBr.resx" LogicalName="AuraToggle.StringsPtBr.resources" />
    <EmbeddedResource Include="src\StringsIt.resx" LogicalName="AuraToggle.StringsIt.resources" />
    <EmbeddedResource Include="src\StringsNl.resx" LogicalName="AuraToggle.StringsNl.resources" />
    <EmbeddedResource Include="src\StringsPl.resx" LogicalName="AuraToggle.StringsPl.resources" />
    <EmbeddedResource Include="src\StringsTr.resx" LogicalName="AuraToggle.StringsTr.resources" />
    <EmbeddedResource Include="src\StringsJa.resx" LogicalName="AuraToggle.StringsJa.resources" />
    <EmbeddedResource Include="src\StringsZh.resx" LogicalName="AuraToggle.StringsZh.resources" />
    <!-- Embedded as well as being the executable icon, so the window can show it crisply. -->
    <EmbeddedResource Include="assets\aura.ico" LogicalName="AuraToggle.aura.ico" />
    <!-- Dimmed variant shown in the tray while the lighting is off. -->
    <EmbeddedResource Include="assets\aura-off.ico" LogicalName="AuraToggle.aura-off.ico" />
  </ItemGroup>

</Project>
